{
  "name": "blue-marble-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "env:mock": "node scripts/dev/switch-env.mjs mock",
    "env:real": "node scripts/dev/switch-env.mjs real",
    "env:show": "node scripts/dev/switch-env.mjs show",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "ai:check:fast": "node scripts/ai/check-fast.mjs",
    "ai:check:lobby": "vitest run src/pages/lobby src/features/presence src/features/room-chat",
    "ai:check:waiting-room": "vitest run src/pages/waiting-room",
    "ai:check:game": "vitest run src/mocks/handlers/game.handler.test.ts src/stores/game.store.test.ts src/hooks/game/useDiceRoll.test.ts src/components/game/modals/promptModalMapping.test.ts",
    "ai:check:ui": "node scripts/ai/check-ui.mjs",
    "ai:check:chat-e2e": "playwright test e2e/chat-flow-direct-message.spec.ts e2e/chat-flow-game-room.spec.ts e2e/chat-flow-waiting-room.spec.ts",
    "ai:check:waiting-room-e2e": "playwright test e2e/waiting-room-start-flow.spec.ts",
    "ai:check:build": "npm run build",
    "ai:self-review": "node scripts/ai/self-review.mjs",
    "ai:validation-plan": "node scripts/ai/validation-plan.mjs",
    "ai:task:new": "node scripts/ai/task-new.mjs",
    "ai:session:brief": "node scripts/ai/session-brief.mjs",
    "ai:workflow:audit": "node scripts/ai/workflow-audit.mjs",
    "ai:pr-gate": "node scripts/ai/pr-gate.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:coverage:owner": "vitest run --config vitest.owner.config.ts --coverage",
    "socket:mock": "tsx mock-socket-server/index.ts",
    "e2e": "playwright test",
    "e2e:ci": "playwright test --grep-invert @game",
    "e2e:game": "playwright test --grep @game",
    "e2e:ui": "playwright test --ui",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite preview",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@tanstack/react-query": "^5.90.21",
    "axios": "^1.13.5",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.19",
    "framer-motion": "^12.34.3",
    "immer": "^11.1.4",
    "lucide-react": "^0.575.0",
    "phaser": "^3.90.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.71.2",
    "react-hot-toast": "^2.6.0",
    "react-router-dom": "^7.13.1",
    "socket.io-client": "^4.8.3",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.2",
    "@commitlint/config-conventional": "^20.4.2",
    "@eslint/js": "^9.15.0",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/vite": "^4.2.1",
    "@tanstack/react-query-devtools": "^5.91.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/express": "^5.0.6",
    "@types/node": "^25.3.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.0.18",
    "@vitest/ui": "^4.0.18",
    "autoprefixer": "^10.4.24",
    "cors": "^2.8.6",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "express": "^5.2.1",
    "globals": "^15.12.0",
    "husky": "^9.1.7",
    "jsdom": "^28.1.0",
    "lint-staged": "^16.2.7",
    "msw": "^2.12.10",
    "postcss": "^8.5.6",
    "prettier": "^3.8.1",
    "socket.io": "^4.8.3",
    "tailwindcss": "^4.2.1",
    "tsx": "^4.21.0",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.15.0",
    "vite": "^5.4.10",
    "vite-plugin-svgr": "^4.5.0",
    "vitest": "^4.0.18"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
